# Optional: replace the bundled MPA training sample with an operator CSV/JSON.
PORT_TRAINING_DATASET_PATH=/absolute/path/to/port_training.csv

# Required when one file contains more than one port. Accepts port_id/unlocode aliases.
PORT_TRAINING_PORT_ID=SGSIN

# Optional: directory for generated checkpoints. Default: .runtime/rl-jobs
RL_ARTIFACT_DIR=/absolute/path/to/rl-artifacts
RL_MAX_CONCURRENT_JOBS=1
RL_MAX_QUEUED_JOBS=20

# Production HTTP server. A non-loopback HOST requires PORT_API_TOKEN.
HOST=127.0.0.1
PORT=5174
# Leave empty for loopback-only development. For remote binding, generate at least 32 random characters.
PORT_API_TOKEN=
API_RATE_LIMIT_PER_MINUTE=120
# Comma-separated cross-origin allowlist. Same-origin requests are always accepted.
API_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Reproducible public-data-calibrated real-time simulator.
PORT_SIMULATOR_SEED=240520
PORT_SIMULATOR_WALL_TICK_MS=5000
PORT_OPERATION_AUDIT_FILE=.runtime/operations/audit-chain.jsonl

# Optional authorized AIS REST endpoint. Never commit the real token.
# Example: https://operator-gateway.example/api/v1/ais/vessels
AIS_REST_ENDPOINT=
AIS_BEARER_TOKEN=

# Optional real-time satellite map. Both values are required before the UI may
# display "卫星影像 + 授权实时 AIS 已验证". Keep AISSTREAM_API_KEY server-side.
# Restrict the MapTiler browser key to the deployment origins in MapTiler Cloud.
MAPTILER_API_KEY=
AISSTREAM_API_KEY=
AISSTREAM_WEBSOCKET_URL=wss://stream.aisstream.io/v0/stream

# Optional Xiaoyi AI service. The embedded advisor remains deterministic and rule-based.
XIAOYI_AI_ENDPOINT=http://127.0.0.1:8010

# Frontend default: public-data-calibrated real-time simulation. A live site adapter may replace it.
VITE_PORT_DATA_ENDPOINT=/api/operations/snapshot

# Scene geometry is independent from training data. Use shanghai-international-port
# with an authorized snapshot endpoint; without VITE_PORT_DATA_ENDPOINT the Shanghai
# template starts in demo mode and does not reuse Singapore telemetry.
VITE_PORT_SCENE_PROFILE=malacca-strait
VITE_PORT_DATA_MODE=public

# Optional strict terminal-operations.v2 mapping manifest.
PORT_OPERATIONAL_MANIFEST_PATH=/absolute/path/to/shanghai-terminal-operations.manifest.json
