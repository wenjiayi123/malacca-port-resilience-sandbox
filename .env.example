# Optional: replace the bundled MPA training sample with an operator CSV/JSON.
PORT_TRAINING_DATASET_PATH=/absolute/path/to/port_training.csv

# Required when one file contains more than one port. Accepts port_id/unlocode aliases.
PORT_TRAINING_PORT_ID=SGSIN

# Optional: directory for generated checkpoints. Default: .runtime/rl-jobs
RL_ARTIFACT_DIR=/absolute/path/to/rl-artifacts
RL_MAX_CONCURRENT_JOBS=1
RL_MAX_QUEUED_JOBS=20

# Production HTTP server. A non-loopback HOST requires PORT_API_TOKEN.
HOST=127.0.0.1
PORT=4173
# Leave empty for loopback-only development. For remote binding, generate at least 32 random characters.
PORT_API_TOKEN=
API_RATE_LIMIT_PER_MINUTE=120

# Optional authorized AIS REST endpoint. Never commit the real token.
AIS_REST_ENDPOINT=https://example-port.invalid/api/v1/ais/vessels
AIS_BEARER_TOKEN=replace-me

# Optional Xiaoyi AI service. The embedded advisor remains deterministic and rule-based.
XIAOYI_AI_ENDPOINT=http://127.0.0.1:8010

# Frontend live snapshot endpoint. Defaults to the same-origin public evidence gateway.
VITE_PORT_DATA_ENDPOINT=/api/public-data/snapshot
