{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/terminal-operations-manifest.v2.json",
  "title": "Terminal Operations Training Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "datasetId",
    "portId",
    "sceneProfileId",
    "source",
    "license",
    "evidenceLevel",
    "timezone",
    "samplingInterval",
    "dataPath",
    "availableFields",
    "fieldMappings"
  ],
  "properties": {
    "protocolVersion": { "const": "terminal-operations.v2" },
    "datasetId": { "type": "string", "minLength": 1 },
    "portId": { "type": "string", "minLength": 1 },
    "sceneProfileId": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string" },
    "license": { "type": "string", "minLength": 1 },
    "evidenceLevel": {
      "enum": [
        "operator-authorized",
        "public-external-validation",
        "synthetic-contract-example"
      ]
    },
    "timezone": { "type": "string", "minLength": 1 },
    "samplingInterval": { "type": "string", "minLength": 1 },
    "dataPath": { "type": "string", "minLength": 1 },
    "availableFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "fieldMappings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
